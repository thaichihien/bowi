{
  "name": "@bowi/plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Framework plugins for Bowi, such as NestJS (PLG-2).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bowi/core": "workspace:*",
    "@bowi/lang": "workspace:*"
  },
  "devDependencies": {
    "@bowi/fixtures": "workspace:*",
    "@bowi/rules": "workspace:*",
    "@bowi/sources": "workspace:*"
  }
}
