{
  "name": "@bowi/core",
  "version": "0.0.0",
  "private": true,
  "description": "Types, stage contract, invariants and determinism helpers for the Bowi analysis engine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./review": "./src/review.ts",
    "./paths": "./src/paths.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "./review": {
        "types": "./dist/review.d.ts",
        "default": "./dist/review.js"
      },
      "./paths": {
        "types": "./dist/paths.d.ts",
        "default": "./dist/paths.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bowi/lang": "workspace:*",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-types": "0.24.8",
    "picomatch": "4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bowi/fixtures": "workspace:*",
    "@bowi/sources": "workspace:*",
    "@types/picomatch": "^4.0.3"
  }
}
