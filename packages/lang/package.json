{
  "name": "@bowi/lang",
  "version": "0.0.0",
  "private": true,
  "description": "Source parsing for Bowi: web-tree-sitter loader, vendored grammars and symbol queries. No dependency on @bowi/core.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "grammars",
    "queries"
  ],
  "scripts": {
    "vendor-grammars": "sh scripts/vendor-grammars.sh"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.1"
  }
}
